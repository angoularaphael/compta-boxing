{
  "$schema": "https://openapi.vercel.sh/schema.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "compta-boxing.vercel.app" }],
      "destination": "https://compta.boxingcenter.fr/$1",
      "permanent": true
    }
  ],
  "functions": {
    "app/api/bots/[slug]/route.js": {
      "maxDuration": 30
    },
    "app/api/invoices/route.js": {
      "maxDuration": 60
    },
    "app/api/invoices/[id]/route.js": {
      "maxDuration": 60
    },
    "app/api/invoices/[id]/reanalyze/route.js": {
      "maxDuration": 60
    },
    "app/api/webhook/whatsapp/route.js": {
      "maxDuration": 60
    },
    "app/api/export/route.js": {
      "maxDuration": 60
    },
    "app/api/statements/route.js": {
      "maxDuration": 60
    }
  }
}
